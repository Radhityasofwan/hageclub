# =============================================================================
# APPLICATION
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="HAGE CLUB"

# =============================================================================
# DATABASE
# =============================================================================
# MySQL connection string - MUST include ?connection_limit=3 for shared hosting
DATABASE_URL="mysql://user:password@localhost:3306/hageclub?connection_limit=3"

# =============================================================================
# AUTHENTICATION (NextAuth.js)
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# CLOUDINARY
# =============================================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# RAJAONGKIR (Shipping + Payment + QRIS)
# =============================================================================
RAJAONGKIR_API_KEY=your-rajaongkir-api-key
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com
# Webhook secret untuk verifikasi notifikasi dari RajaOngkir
RAJAONGKIR_WEBHOOK_SECRET=your-webhook-secret
# ID QRIS statis untuk konversi ke QRIS dinamis via QRISLY
RAJAONGKIR_STATIC_QRIS_ID=your-static-qris-id
# Origin city ID untuk kalkulasi ongkir (city ID RajaOngkir)
RAJAONGKIR_ORIGIN_CITY_ID=152

# =============================================================================
# EMAIL (SMTP via cPanel)
# =============================================================================
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASS=your-email-password
EMAIL_FROM="HAGE CLUB <noreply@yourdomain.com>"

# =============================================================================
# CRON (Scheduled Tasks)
# =============================================================================
# Secret token to authenticate cron job requests to /api/cron/*
# Generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here
